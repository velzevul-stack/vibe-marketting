{
  "_comment": "Скопируйте в settings.json и заполните. Строки с _comment игнорируются.",

  "telegram_index_api_key": "",
  "tgstat_token": "",
  "telemetr_api_key": "",
  "ddgs_search_enabled": true,
  "tg_catalog_enabled": true,
  "_exclude_ru_cities_comment": "true — не искать по городам из data/russian_cities_blocklist.json и убрать их из выдачи",
  "exclude_russian_cities_in_search": true,

  "_group_links_comment": "Файл в config/: по одной ссылке t.me на строку — для сбора/вступления без поиска",
  "group_links_file": "group_links.txt",

  "telethon_session_dir": "sessions",
  "_bulk_2fa_comment": "Пустая строка = пароль 2FA из кода (AUTO_2FA_PASSWORD_DEFAULT). Иначе свой.",
  "bulk_2fa_password": "",
  "bulk_prepare_delay_sec": 5,
  "assign_proxies_on_startup": false,
  "_proxy_enabled_comment": "false — не использовать прокси в поиске и Telethon (можно переключать: python main.py --proxy on|off)",
  "proxy_enabled": true,
  "_scrape_proxy_comment": "false — сбор базы без прокси из пула (при proxy_enabled true); join/invite без изменений",
  "scrape_use_proxy": true,
  "_scrape_session_comment": "имя session_name — только эта сессия для сбора, группы по очереди; пусто — ротация как раньше",
  "scrape_session_name": "",
  "sync_sessions_on_startup": true,

  "_campaign_dir_comment": "Папка пакета рассылки по умолчанию (меню 9→6): zip, apis.txt, proxies.txt, text_1/2.txt, 1–3.jpg",
  "campaign_dir": "campaign",

  "_broadcast_limit_comment": "Макс. успешных ЛС с одного аккаунта за сутки UTC; 0 = без лимита (счётчик в SQLite)",
  "broadcast_daily_limit_per_account": 25,
  "broadcast_homoglyph_enabled": true,
  "_homoglyph_p_comment": "Вероятность замены одной буквы е/а/о (кирил.) на латиницу в подписи к картинке",
  "broadcast_homoglyph_probability": 0.12,
  "_broadcast_relay_comment": "Макс. число разных аккаунтов на одного получателя за прогон; после PeerFlood N раз — сессия отдыхает до конца прогона",
  "broadcast_max_account_attempts_per_user": 3,
  "broadcast_retire_session_after_peer_floods": 2,
  "_broadcast_precache_comment": "true: перед прогоном залить три картинки в Избранное и слать ЛС по кэшу медиа; false — каждый раз с диска",
  "broadcast_precache_media_to_saved": true,
  "_broadcast_gap_comment": "Секунды между попытками (OK/skip/relay) внутри одной API-группы при рассылке из БД; опционально max для случайного uniform",
  "broadcast_min_gap_between_accounts_sec": 300,
  "broadcast_min_gap_between_accounts_max_sec": null,
  "_broadcast_session_comment": "Пауза сессии в БД-рассылке (сек): после входа, между попытками; опционально max для uniform (как CSV delay)",
  "broadcast_session_interval_sec": 1800,
  "broadcast_session_interval_max_sec": null,

  "telethon_default_api": {
    "_comment": "Для автопривязки .session (меню сессий → 4): общий api_id/api_hash с my.telegram.org",
    "api_id": null,
    "api_hash": ""
  },

  "proxies": {
    "source": "files",
    "files": ["proxies.txt"],
    "list": []
  },

  "_mytg_comment": "Playwright: Telegram Web + my.telegram.org (меню 9→4). mytg_headless=false снижает детект; на Linux сервере часто xvfb-run.",
  "mytg_headless": false,
  "mytg_chromium_channel": null,
  "mytg_portal_code_timeout_sec": 120,
  "mytg_create_retry_wait_sec": 1800,
  "mytg_wait_after_web_sec": 86400,
  "mytg_delays": {
    "after_navigate": { "min": 1.5, "max": 4 },
    "after_click": { "min": 0.8, "max": 2.5 },
    "after_type": { "min": 0.35, "max": 1.2 },
    "after_submit": { "min": 2, "max": 5 },
    "poll_portal_code": { "min": 2, "max": 5 }
  },

  "delays": {
    "join_min": 30,
    "join_max": 120,
    "contact_min": 60,
    "contact_max": 180,
    "invite_min": 90,
    "invite_max": 240,
    "search_min": 2,
    "search_max": 6,
    "scrape_between_groups": 2,
    "scrape_per_message": 0,
    "_broadcast_comment": "Пауза между исходящими ЛС в рассылке (сек., на каждый аккаунт-воркер)",
    "broadcast_min": 45,
    "broadcast_max": 120
  }
}

